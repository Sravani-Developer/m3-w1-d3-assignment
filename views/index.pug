extends layout

block content
  h2.text-center.mb-4 Registrations

  if registrations.length
    table.table.table-striped.table-bordered
      thead.thead-dark
        tr
          th Name
          th Email
      tbody
        each reg in registrations
          tr
            td #{reg.name}
            td #{reg.email}
  else
    p.text-muted.text-center No registrations yet

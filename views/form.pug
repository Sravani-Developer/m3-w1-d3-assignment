extends layout

block content
  h2.text-center.mb-4 Registration Form

  if errors
    .alert.alert-danger
      ul.mb-0
        each error in errors
          li #{error.msg}

  form(method="POST", action="/")
    .form-group
      label(for="name") Name
      input.form-control(
        type="text",
        id="name",
        name="name",
        value=(data && data.name ? data.name : '')
      )

    .form-group
      label(for="email") Email
      input.form-control(
        type="email",
        id="email",
        name="email",
        value=(data && data.email ? data.email : '')
      )

    button.btn.btn-primary.btn-block(type="submit") Submit
